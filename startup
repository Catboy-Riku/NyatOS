                " ",
                BAR_WIDTH
            )
        )

        if filledWidth > 0 then
            monitor.setBackgroundColor(
                colors.green
            )

            monitor.setCursorPos(
                barX,
                barY
            )

            monitor.write(
                string.rep(
                    " ",
                    filledWidth
                )
            )
        end

        monitor.setBackgroundColor(
            colors.lime
        )

        local percent =
            math.floor(
                progress * 100
            )

        local progressText =
            percent .. "%"

        monitor.setTextColor(
            colors.white
        )

        monitor.setCursorPos(
            math.floor(
                screenCenterX
                - (#progressText / 2)
            ) + 2,
            26
        )

        monitor.write(progressText)

        if progress >= 1 then
            finishRecovery()
        else
            recoveryTimer =
                os.startTimer(0.1)
