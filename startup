end

loadClientCryptoKey = function()
    local file =
        fs.open(
            clientKeyFile,
            "r"
        )

    if not file then
        return nil
    end

    local key =
        file.readAll()

    file.close()

    key =
        key:gsub(
            "^%s+",
            ""
        ):gsub(
            "%s+$",
            ""
        )

    if key == "" then
        return nil
    end

    return key
end

local function saveClientCryptoKey(key)
    if type(key) ~= "string"
        or key == ""
    then
        return false,
            "Invalid crypto key."
    end

    local file, err =
        fs.open(
            clientKeyFile,
            "w"
        )

    if not file then
        return false,
            "Could not save crypto key: "
            .. tostring(err)
    end

    file.write(key)
    file.close()

    return true
end

local function requestCryptoKey()
    local modem, modemError =
        getModem()

    if not modem then
        return false,
            modemError
    end

    modem.open(REPLY_CHANNEL)

    local requestID =
        tostring(os.getComputerID())
        .. "-"
        .. tostring(os.epoch("utc"))
        .. "-"
        .. tostring(
            math.random(
                1,
                1000000
            )
        )

    local request = {
        requestID = requestID,
        clientID = os.getComputerID(),
        action = "provision_key"
    }

    modem.transmit(
        DATABASE_CHANNEL,
        REPLY_CHANNEL,
        textutils.serialize(
            request
        )
    )

    local timer =
        os.startTimer(5)

    while true do
        local event,
            p1,
            p2,
            p3,
            p4 =
            os.pullEvent()

        if event == "modem_message" then
            local channel = p2
            local message = p4

            if channel == REPLY_CHANNEL
                and type(message) == "string"
            then
                local response =
                    textutils.unserialize(
                        message
                    )

                if type(response) == "table"
                    and response.requestID == requestID
                    and response.clientID == os.getComputerID()
                    and response.provisioned == true
                    and type(response.key) == "string"
                then
                    os.cancelTimer(timer)

                    local saveOK,
                        saveError =
                        saveClientCryptoKey(
                            response.key
                        )

                    if not saveOK then
                        return false,
                            saveError
                    end

                    return true
                end
            end

        elseif event == "timer"
            and p1 == timer
        then
            return false,
                "Crypto key provisioning timed out."
        end
    end
end

