local function databaseServer()
    local modem, modemError = getModem()

    if not modem then
        error("Database server requires a modem: " .. tostring(modemError))
    end

    modem.open(DATABASE_CHANNEL)

    while true do
        local _, side, channel, replyChannel, message =
            os.pullEvent("modem_message")

        if channel == DATABASE_CHANNEL
            and type(message) == "string"
        then
            local request =
                textutils.unserialize(
                    message
                )

            cleanupDatabaseRequests()

            if type(request) == "table"
                and request.requestID
                and request.clientID
            then
                local requestTimestamp =
                    tonumber(
                        request.timestamp
                    )

                local requestAge

                if requestTimestamp then
                    requestAge =
                        math.abs(
                            os.epoch("utc")
                            - requestTimestamp
                        )
                end

                if request.action == "provision_key" then
                    local clientKey =
                        getClientCryptoKeyLocal(
                            request.clientID
                        )

                    if not clientKey then
                        clientKey =
                            crypto.generateKey()

                        local saveOK =
                            setClientCryptoKeyLocal(
                                request.clientID,
                                clientKey
                            )

                        if not saveOK then
                            clientKey = nil
                        end
                    end

                    if clientKey then
                        local response = {
                            requestID =
                                request.requestID,

                            clientID =
                                request.clientID,

                            provisioned = true,

                            key =
                                clientKey
                        }

                        modem.transmit(
                            replyChannel,
                            DATABASE_CHANNEL,
                            textutils.serialize(
                                response
                            )
                        )
                    end

                elseif request.encrypted == true
                    and type(request.packet) == "table"
                    and requestTimestamp
                    and requestAge
                    and requestAge <= DATABASE_REPLAY_WINDOW * 1000
                then
                    local clientRequests =
                        seenDatabaseRequests[
                            tostring(
                                request.clientID
                            )
                        ]

                    if type(clientRequests) ~= "table" then
                        clientRequests = {}

                        seenDatabaseRequests[
                            tostring(
                                request.clientID
                            )
                        ] = clientRequests
                    end

                    if not clientRequests[
                        request.requestID
                    ] then
                        local clientKey =
                            getClientCryptoKey(
                                request.clientID
                            )

                        local authenticatedRequest = false
                        local requestPayload = nil

                        if type(clientKey) == "string"
                            and clientKey ~= ""
                        then
                            local associatedData =
                                "nyatos-db-request|"
                                .. tostring(request.clientID)
                                .. "|"
                                .. tostring(request.requestID)
                                .. "|"
                                .. tostring(requestTimestamp)

                            local decryptOK,
                                decryptedRequest =
                                crypto.decrypt(
                                    clientKey,
                                    request.packet,
                                    associatedData
                                )

                            if decryptOK then
                                requestPayload =
                                    textutils.unserialize(
                                        decryptedRequest
                                    )

                                if type(requestPayload) == "table"
                                    and type(requestPayload.action) == "string"
                                then
                                    authenticatedRequest = true

                                    clientRequests[
                                        request.requestID
                                    ] = os.epoch("utc")
                                end
                            end
                        end

                        if authenticatedRequest then
                            request.action =
                                requestPayload.action

                            request.data =
                                requestPayload.data

                            local success = false
                            local responseData = nil
                            local errorMessage = nil

                            if request.action == "authenticate" then
                                local inputUser =
                                    request.data
                                    and request.data.username

                                local inputPass =
                                    request.data
                                    and request.data.password

                                if not inputUser
                                    or not inputPass
                                then
                                    errorMessage =
                                        "Missing username or password."
                                else
                                    local authenticated,
                                        result =
                                        authenticateUserLocal(
                                            inputUser,
                                            inputPass
                                        )

                                    if authenticated then
                                        success = true
                                        responseData = result
                                    else
                                        errorMessage = result
                                    end
                                end

                            elseif request.action == "get_user" then
                                local sessionToken =
                                    request.data
                                    and request.data.sessionToken

                                local currentUser =
                                    getSessionUser(
                                        sessionToken
                                    )

                                if not currentUser then
                                    errorMessage =
                                        "Invalid or expired session."
                                else
                                    success = true

                                    responseData =
                                        getPublicUser(
                                            currentUser
                                        )
                                end

                            elseif request.action == "change_password" then
                                local username =
                                    request.data
                                    and request.data.username

                                local currentPassword =
                                    request.data
                                    and request.data.currentPassword

                                local newPassword =
                                    request.data
                                    and request.data.newPassword

                                if not username
                                    or not currentPassword
                                    or not newPassword
                                    or newPassword == ""
                                then
                                    errorMessage =
                                        "Invalid password data."
                                else
                                    local targetUser = nil

                                    for _, u in ipairs(users) do
                                        if u.username == username then
                                            targetUser = u
                                            break
                                        end
                                    end

                                    if not targetUser then
                                        errorMessage =
                                            "User not found."

                                    elseif targetUser.password ~= currentPassword then
                                        errorMessage =
                                            "Current password is incorrect."

                                    else
                                        targetUser.password =
                                            newPassword

                                        if saveUserDataLocal() then
                                            success = true
                                        else
                                            errorMessage =
                                                "Failed to save password."
                                        end
                                    end
                                end

                            elseif request.action == "create_user" then
                                local sessionToken =
                                    request.data
                                    and request.data.sessionToken

                                local newUsername =
                                    request.data
                                    and request.data.newUsername

                                local newPassword =
                                    request.data
                                    and request.data.newPassword

                                local newAdmin =
                                    request.data
                                    and request.data.newAdmin

                                local adminSuccess,
                                    adminUser,
                                    adminError =
                                    authenticateAdminLocal(
                                        sessionToken
                                    )

                                if not adminSuccess then
                                    errorMessage =
                                        adminError

                                elseif not newUsername
                                    or not newPassword
                                    or newUsername == ""
                                    or newPassword == ""
                                then
                                    errorMessage =
                                        "Invalid user data."
                                else
                                    local duplicate = false

                                    for _, account in ipairs(users) do
                                        if account.username == newUsername then
                                            duplicate = true
                                            break
                                        end
                                    end

                                    if duplicate then
                                        errorMessage =
                                            "Username already exists."
                                    else
                                        table.insert(
                                            users,
                                            {
                                                username =
                                                    newUsername,

                                                password =
                                                    newPassword,

                                                admin =
                                                    newAdmin == true,

                                                rsAccess = false
                                            }
                                        )

                                        if saveUserDataLocal() then
                                            success = true
                                        else
                                            table.remove(
                                                users,
                                                #users
                                            )

                                            errorMessage =
                                                "Failed to save user data."
                                        end
                                    end
                                end

                            elseif request.action == "change_permissions" then
                                local sessionToken =
                                    request.data
                                    and request.data.sessionToken

                                local targetUsername =
                                    request.data
                                    and request.data.targetUsername

                                local changeAdmin =
                                    request.data
                                    and request.data.changeAdmin

                                local changeRS =
                                    request.data
                                    and request.data.changeRS

                                if not sessionToken
                                    or not targetUsername
                                then
                                    errorMessage =
                                        "Invalid permission data."
                                else
                                    local adminSuccess,
                                        adminUser,
                                        adminError =
                                        authenticateAdminLocal(
                                            sessionToken
                                        )

                                    if not adminSuccess then
                                        errorMessage =
                                            adminError
                                            or "Administrator authentication failed."

                                    else
                                        local targetUser = nil

                                        for _, account in ipairs(users) do
                                            if account.username == targetUsername then
                                                targetUser = account
                                                break
                                            end
                                        end

                                        if not targetUser then
                                            errorMessage =
                                                "User not found."

                                        elseif changeAdmin
                                            and targetUser.username == adminUser.username
                                        then
                                            errorMessage =
                                                "You cannot change your own admin status."

                                        else
                                            if changeAdmin then
                                                targetUser.admin =
                                                    not targetUser.admin
                                            end

                                            if changeRS then
                                                targetUser.rsAccess =
                                                    not targetUser.rsAccess
                                            end

                                            if saveUserDataLocal() then
                                                success = true

                                                responseData =
                                                    getPublicUser(
                                                        targetUser
                                                    )
                                            else
                                                errorMessage =
                                                    "Failed to save user data."
                                            end
                                        end
                                    end
                                end

                            elseif request.action == "toggle_admin" then
                                local sessionToken =
                                    request.data
                                    and request.data.sessionToken

                                local targetUsername =
                                    request.data
                                    and request.data.targetUsername

                                if not sessionToken
                                    or not targetUsername
                                    or targetUsername == ""
                                then
                                    errorMessage =
                                        "Invalid admin data."
                                else
                                    local adminSuccess,
                                        _,
                                        adminError =
                                        authenticateAdminLocal(
                                            sessionToken
                                        )

                                    if not adminSuccess then
                                        errorMessage =
                                            adminError
                                            or "Administrator authentication failed."

                                    else
                                        local targetUser = nil

                                        for _, account in ipairs(users) do
                                            if account.username == targetUsername then
                                                targetUser = account
                                                break
                                            end
                                        end

                                        if not targetUser then
                                            errorMessage =
                                                "User not found."
                                        else
                                            targetUser.admin =
                                                not targetUser.admin

                                            if saveUserDataLocal() then
                                                success = true

                                                responseData = {
                                                    username =
                                                        targetUser.username,

                                                    admin =
                                                        targetUser.admin
                                                }
                                            else
                                                targetUser.admin =
                                                    not targetUser.admin

                                                errorMessage =
                                                    "Failed to save user data."
                                            end
                                        end
                                    end
                                end

                            elseif request.action == "rename_user" then
                                local oldUsername =
                                    request.data
                                    and request.data.oldUsername

                                local newUsername =
                                    request.data
                                    and request.data.newUsername

                                if not oldUsername
                                    or not newUsername
                                    or newUsername == ""
                                then
                                    errorMessage =
                                        "Invalid username data."
                                else
                                    for _, u in ipairs(users) do
                                        if u.username == newUsername then
                                            errorMessage =
                                                "Username already exists."
                                            break
                                        end
                                    end

                                    if not errorMessage then
                                        local targetUser = nil

                                        for _, u in ipairs(users) do
                                            if u.username == oldUsername then
                                                targetUser = u
                                                break
                                            end
                                        end

                                        if not targetUser then
                                            errorMessage =
                                                "User not found."
                                        else
                                            local saveSuccess,
                                                saveError =
                                                renameUserSavesLocal(
                                                    oldUsername,
                                                    newUsername
                                                )

                                            if not saveSuccess then
                                                errorMessage =
                                                    saveError
                                                    or "Failed to rename user saves."
                                            else
                                                local oldUsernameValue =
                                                    targetUser.username

                                                targetUser.username =
                                                    newUsername

                                                if saveUserDataLocal() then
                                                    success = true
                                                else
                                                    targetUser.username =
                                                        oldUsernameValue

                                                    renameUserSavesLocal(
                                                        newUsername,
                                                        oldUsername
                                                    )

                                                    errorMessage =
                                                        "Failed to save user data."
                                                end
                                            end
                                        end
                                    end
                                end

                            elseif request.action == "get_startup" then
                                local file =
                                    fs.open(
                                        "startup",
                                        "r"
                                    )

                                if file then
                                    responseData =
                                        file.readAll()

                                    file.close()

                                    success = true
                                else
                                    errorMessage =
                                        "Server startup file could not be read."
                                end

                            elseif request.action == "load_game_save" then
                                local username =
                                    request.data
                                    and request.data.username

                                local game =
                                    request.data
                                    and request.data.game

                                if username and game then
                                    success = true

                                    responseData =
                                        loadGameSaveLocal(
                                            username,
                                            game
                                        )
                                else
                                    errorMessage =
                                        "Missing username or game name."
                                end

                            elseif request.action == "save_game_save" then
                                local username =
                                    request.data
                                    and request.data.username

                                local game =
                                    request.data
                                    and request.data.game

                                local data =
                                    request.data
                                    and request.data.data

                                if username
                                    and game
                                    and type(data) == "table"
                                then
                                    success =
                                        saveGameSaveLocal(
                                            username,
                                            game,
                                            data
                                        )

                                    if not success then
                                        errorMessage =
                                            "Failed to save game data."
                                    end
                                else
                                    errorMessage =
                                        "Invalid game save data."
                                end

                            elseif request.action == "delete_game_save" then
                                local username =
                                    request.data
                                    and request.data.username

                                local game =
                                    request.data
                                    and request.data.game

                                if username and game then
                                    success =
                                        deleteGameSaveLocal(
                                            username,
                                            game
                                        )
                                else
                                    errorMessage =
                                        "Missing username or game name."
                                end

                            else
                                errorMessage =
                                    "Unknown database action."
                            end

                            local responsePayload = {
                                ok = success,
                                data = responseData,
                                error = errorMessage
                            }

                            local clientKey =
                                getClientCryptoKey(
                                    request.clientID
                                )

                            if type(clientKey) == "string"
                                and clientKey ~= ""
                            then
                                local associatedData =
                                    "nyatos-db-response|"
                                    .. tostring(request.clientID)
                                    .. "|"
                                    .. tostring(request.requestID)

                                local encryptOK,
                                    encryptedPacket,
                                    encryptError =
                                    crypto.encrypt(
                                        clientKey,
                                        textutils.serialize(
                                            responsePayload
                                        ),
                                        associatedData,
                                        cryptoNonceFile,
                                        "database-response-"
                                            .. tostring(
                                                request.clientID
                                            )
                                    )

                                if encryptOK then
                                    local response = {
                                        requestID =
                                            request.requestID,

                                        clientID =
                                            request.clientID,

                                        encrypted = true,

                                        packet =
                                            encryptedPacket
                                    }

                                    modem.transmit(
                                        replyChannel,
                                        DATABASE_CHANNEL,
                                        textutils.serialize(
                                            response
                                        )
                                    )
                                end
                            end
                        end
                    end
                end
            end
        end
    end
end

local function readLockoutState()
    local file, err = fs.open(lockoutFile, "r")

    if file then
        local state = file.readAll()
        file.close()
        return tonumber(state) or 0
    end

    print("Error reading lockout file:", err)
    return 0
end

local function writeLockoutState(attempts)
    local file, err = fs.open(lockoutFile, "w")

    if file then
        file.write(tostring(attempts))
        file.close()
    else
        print("Error writing lockout file:", err)
    end
end

local function loadRSOptions()
    local defaults = {
        side = "back",
        mode = "timer",
        opentime = 5
    }

    local file = fs.open(rsOptionsFile, "r")

    if not file then
        file = fs.open(rsOptionsFile, "w")

        if file then
            file.write("side=back;mode=timer;opentime=5")
            file.close()
            return defaults
        else
            return nil, "Could not create rsoptions file."
        end
    end

    local data = file.readAll()
    file.close()

    local options = {
        side = nil,
        mode = nil,
        opentime = nil
    }

    for key, value in data:gmatch("([^=;]+)=([^;]+)") do
        key = key:lower()
        value = value:gsub("^%s+", ""):gsub("%s+$", "")

        if key == "side" then
            value = value:lower()

            if value == "top" or value == "bottom" or value == "left" or
               value == "right" or value == "front" or value == "back" then
                options.side = value
            else
                return nil, "Invalid side: " .. value
            end

        elseif key == "mode" then
            value = value:lower()

            if value == "timer" or value == "toggle" then
                options.mode = value
            else
                return nil, "Invalid mode: " .. value
            end

        elseif key == "opentime" then
            local duration = tonumber(value)

            if duration and duration >= 0 then
                options.opentime = duration
            else
                return nil, "Invalid opentime: " .. value
            end

        else
            return nil, "Unknown setting: " .. key
        end
    end

    if not options.side then
        return nil, "Missing 'side' setting."
    end

    if not options.mode then
        return nil, "Missing 'mode' setting."
    end

    if options.mode == "timer" and options.opentime == nil then
        return nil, "Missing 'opentime' setting."
    end

    return options
end

local rsToggleStateFile = "rstoggle.state"

local function loadRSToggleState()
    if not fs.exists(rsToggleStateFile) then
        return nil
    end

    local file = fs.open(rsToggleStateFile, "r")

    if not file then
        return nil
    end

    local side = file.readAll()
    file.close()

    side = side:gsub("^%s+", ""):gsub("%s+$", "")

    if side == "top" or side == "bottom" or side == "left" or
       side == "right" or side == "front" or side == "back" then
        return side
    end

    return nil
end

local function saveRSToggleState(side)
    local file = fs.open(rsToggleStateFile, "w")

    if file then
        file.write(side or "")
        file.close()
    end
end

local function playForestQuest(user)
    local state = {
        version = 2,
        location = "entrance",
        health = 100,
        maxHealth = 100,
        gold = 0,
        inventory = {},
        flags = {},
        stats = {
            moves = 0,
            battles = 0,
            secrets = 0
        }
    }

    local running = true
    local victory = false
	local forestMusicRunning = true
	local forestMusicURL =
		"https://raw.githubusercontent.com/Catboy-Riku/NyatOS/main/music/Forest%20Interlude.dfpwm"

	local forestMusicSpeaker =
		peripheral.find("speaker")


	local function playForestMusic()
		if not forestMusicSpeaker then
			return
		end

		if not http then
			return
		end

		local dfpwm =
			require("cc.audio.dfpwm")

		while forestMusicRunning do
			local response,
				requestError =
				http.get(
					forestMusicURL,
					nil,
					true
				)

			if not response then
				return
			end

			local responseCode =
				response.getResponseCode()

			if responseCode ~= 200 then
				response.close()
				return
			end

			local decoder =
				dfpwm.make_decoder()

			while forestMusicRunning do
				local chunk =
					response.read(
						16 * 1024
					)

				if not chunk then
					break
				end

				local audio =
					decoder(chunk)

				while forestMusicRunning
					and not forestMusicSpeaker.playAudio(
						audio,
						0.5
					)
				do
					os.pullEvent(
						"speaker_audio_empty"
					)
				end
			end

			response.close()

			if forestMusicRunning then
				sleep(0.1)
			end
		end

		forestMusicSpeaker.stop()
	end

    local function clearScreen()
        term.clear()
        term.setCursorPos(1, 1)
    end

    local function pause(message)
        print("")
        print(message or "Press Enter to continue...")
        read()
    end

    local function hasItem(item)
        return state.inventory[item] == true
    end

    local function addItem(item)
        state.inventory[item] = true
    end

    local function removeItem(item)
        state.inventory[item] = nil
    end

    local function setFlag(flag, value)
        state.flags[flag] = value
    end

    local function hasFlag(flag)
        return state.flags[flag] == true
    end

    local function saveGame()
        local success =
            saveForestQuestData(
                user.username,
                state
            )

        if not success then
            clearScreen()
            print("Unable to save Forest Quest.")
            print("")
            print("The central NyatOS database could not be reached.")
            pause()
            return false
        end

        return true
    end

    local function loadGame()
        local success, loaded =
            loadForestQuestData(
                user.username
            )

        if not success then
            return false
        end

        if type(loaded) ~= "table" or loaded.version ~= 2 then
            return false
        end

        if type(loaded.inventory) ~= "table" then
            loaded.inventory = {}
        end

        if type(loaded.flags) ~= "table" then
            loaded.flags = {}
        end

        if type(loaded.stats) ~= "table" then
            loaded.stats = {
                moves = 0,
                battles = 0,
                secrets = 0
            }
        end

        loaded.maxHealth = tonumber(loaded.maxHealth) or 100
        loaded.health = tonumber(loaded.health) or loaded.maxHealth
        loaded.gold = tonumber(loaded.gold) or 0
        loaded.location = loaded.location or "entrance"
        loaded.stats.moves = tonumber(loaded.stats.moves) or 0
        loaded.stats.battles = tonumber(loaded.stats.battles) or 0
        loaded.stats.secrets = tonumber(loaded.stats.secrets) or 0

        state = loaded
        return true
    end

    local function deleteSave()
        deleteForestQuestData(user.username)
    end

    local function autoSaveGame()
        return saveForestQuestData(
            user.username,
            state
        )
    end

    local function itemList()
        local items = {}

        for item, owned in pairs(state.inventory) do
            if owned then
                table.insert(items, item)
            end
        end

        table.sort(items)
        return items
    end

    local function showInventory()
        clearScreen()
        print("========== INVENTORY ==========")
        print("")
        print("Health: " .. state.health .. "/" .. state.maxHealth)
        print("Gold: " .. state.gold)
        print("")

        local items = itemList()

        if #items == 0 then
            print("Your inventory is empty.")
        else
            for _, item in ipairs(items) do
                print("- " .. item)
            end
        end

        print("")
        print("Stats:")
        print("  Steps: " .. state.stats.moves)
        print("  Battles: " .. state.stats.battles)
        print("  Secrets discovered: " .. state.stats.secrets)

        pause()
    end

    local function showStatus()
        clearScreen()
        print("========== CHARACTER ==========")
        print("")
        print("Adventurer: " .. user.username)
        print("Health: " .. state.health .. "/" .. state.maxHealth)
        print("Gold: " .. state.gold)
        print("Location: " .. state.location)
        print("")
        print("The forest seems to react to every choice you make.")

        pause()
    end

    local function damage(amount)
        state.health = math.max(0, state.health - amount)

        print("")
        print("You lose " .. amount .. " health.")
        print("Health: " .. state.health .. "/" .. state.maxHealth)

        return state.health <= 0
    end

    local function heal(amount)
        local oldHealth = state.health

        state.health =
            math.min(
                state.maxHealth,
                state.health + amount
            )

        print("")
        print(
            "You recover "
            .. (state.health - oldHealth)
            .. " health."
        )

        print(
            "Health: "
            .. state.health
            .. "/"
            .. state.maxHealth
        )
    end

    local function invalidChoice()
        print("")
        print("Invalid choice. Nothing happens.")
        sleep(1)
    end

    local function gameOver(reason)
        clearScreen()
        print("========== GAME OVER ==========")
        print("")
        print(reason)
        print("")
        print("Your Forest Quest save has been preserved.")
        print("You can resume from your last saved point later.")
        print("")
        print("[1] Return to the last safe point")
        print("[2] Delete Forest Quest save")
        print("[3] Leave Forest Quest")
        print("")

        local choice = read()

        if choice == "1" then
            state.health = math.max(1, math.floor(state.maxHealth * 0.5))
            state.location = "entrance"
            state.flags.guardianDefeated = false
            running = true

        elseif choice == "2" then
            deleteSave()
            pause("Save deleted. Press Enter to leave Forest Quest...")
            running = false

        elseif choice == "3" then
            running = false

        else
            invalidChoice()
            return gameOver(reason)
        end
    end

    local function combat(enemyName, enemyHealth, enemyDamage, rewardGold)
        state.stats.battles = state.stats.battles + 1

        local enemyHP = enemyHealth

        while enemyHP > 0 and state.health > 0 and running do
            clearScreen()

            print("========== " .. enemyName:upper() .. " ==========")
            print("")
            print(enemyName .. " HP: " .. enemyHP)
            print("Your HP: " .. state.health .. "/" .. state.maxHealth)
            print("")
            print("[1] Attack")
            print("[2] Defend")
            print("[3] Use Healing Herb")
            print("[4] Flee")
            print("")

            local choice = read()

            if choice == "1" then
                local damageAmount = 12

                if hasItem("Hunter's Knife") then
                    damageAmount = 20
                end

                enemyHP = math.max(0, enemyHP - damageAmount)

                print("")
                print("You deal " .. damageAmount .. " damage.")

                if enemyHP > 0 then
                    if damage(enemyDamage) then
                        gameOver("The " .. enemyName .. " overpowers you.")
                        return false
                    end
                end

                sleep(1)

            elseif choice == "2" then
                local reduced = math.max(1, math.floor(enemyDamage / 2))

                print("")
                print("You brace yourself and reduce the incoming damage.")

                if damage(reduced) then
                    gameOver("Your defenses finally fail.")
                    return false
                end

                sleep(1)

            elseif choice == "3" then
                if hasItem("Healing Herb") then
                    removeItem("Healing Herb")
                    heal(25)

                    if enemyHP > 0 then
                        if damage(enemyDamage) then
                            gameOver(
                                "The "
                                .. enemyName
                                .. " catches you while you heal."
                            )
                            return false
                        end
                    end

                    sleep(1)
                else
                    print("")
                    print("You don't have a Healing Herb.")
                    sleep(1)
                end

            elseif choice == "4" then
                if math.random(1, 100) <= 60 then
                    print("")
                    print("You escape into the trees.")
                    state.location = "forest"
                    sleep(1)
                    return false
                end

                print("")
                print("You fail to escape!")

                if damage(enemyDamage) then
                    gameOver("You are caught before you can get away.")
                    return false
                end

                sleep(1)

            else
                invalidChoice()
            end
        end

        if enemyHP <= 0 then
            state.gold = state.gold + rewardGold

            print("")
            print("You defeat the " .. enemyName .. "!")
            print("You find " .. rewardGold .. " gold.")
            sleep(1)

            return true
        end

        return false
    end

