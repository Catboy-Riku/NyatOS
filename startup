    local function touchIsInside(
        x,
        y,
        coords
    )
        return #coords == 4
            and x >= coords[1]
            and y >= coords[2]
            and x <= coords[3]
            and y <= coords[4]
    end

    local function isTouchDebounced()
        local now =
            os.epoch("utc")

        if now - lastTouchTime < 100 then
            return false
        end

        lastTouchTime = now

        return true
    end

    local function handleBettingTouch(
        x,
        y
    )
        if touchIsInside(
            x,
            y,
            betDownCoords
        ) then

            currentBet =
                math.max(
                    MIN_BET,
                    currentBet
                    - BET_INCREMENT
                )

        elseif touchIsInside(
            x,
            y,
            betUpCoords
        ) then

            currentBet =
                math.min(
                    balance,
                    currentBet
                    + BET_INCREMENT
                )

            currentBet =
                math.floor(
                    currentBet
                    / BET_INCREMENT
                )
                * BET_INCREMENT

            if currentBet < MIN_BET then
                currentBet = MIN_BET
            end

        elseif touchIsInside(
            x,
            y,
            dealCoords
        ) then

            startGame()

            return
        end

        loadBettingScreen()
    end

    local function handlePlayingTouch(
        x,
        y
    )
        if touchIsInside(
            x,
            y,
            standCoords
        ) then

            finishRound(false)

            return
        end

        if touchIsInside(
            x,
            y,
            hitCoords
        ) then

            giveCard(playerHand)

            monitor.clear()

            drawCards(playerHand)
            drawDealerCards()
            drawButtons()

            if isBust(playerHand) then
                finishRound(true)
            end
        end
    end

    loadMenu()

    while true do
        local event, a, b, c =
            os.pullEvent()

        if event == "monitor_touch" then
            if not isTouchDebounced() then
                goto continue
            end

            local x = b
            local y = c

			if gameState == "menu" then
				if touchIsInside(
					x,
					y,
					withdrawCoords
				) then
					if startTimer then
						os.cancelTimer(startTimer)
						startTimer = nil
					end

					withdrawFunds()

					goto continue

				elseif touchIsInside(
					x,
					y,
					exitCoords
				) then
					monitor.setBackgroundColor(colors.black)
					monitor.setTextColor(colors.white)
					monitor.clear()

					restoreTerminal()
					return
				end

				if balance < 10 then
					startRecovery()
				elseif not startTimer then
					startTimer =
						os.startTimer(0.2)
				end

            elseif gameState == "betting" then
                if touchIsInside(
                    x,
                    y,
                    exitCoords
                ) then
                    if startTimer then
                        os.cancelTimer(startTimer)
                        startTimer = nil
                    end

                    gameState = "menu"
                    loadMenu()
                else
                    handleBettingTouch(x, y)
                end

            elseif gameState == "playing" then
                handlePlayingTouch(x, y)

            elseif gameState == "recovery" then
                -- Ignore input while recovery is running.

            elseif gameState == "finished" then
                -- Ignore input while waiting for the next round.
            end

        elseif event == "timer" then
            if a == startTimer then
                startTimer = nil

                if balance == 0 then
                    startRecovery()
                else
                    loadBettingScreen()
                end

            elseif a == tickTimer then
                tickTimer = nil
                tick()

			elseif a == resetTimer then
				resetTimer = nil

				playerHand = {}

				dealerHand = {
					visible = {},
					hidden = {}
				}

				hitCoords = {}
				standCoords = {}

				if returnToMenuAfterWithdraw then
					returnToMenuAfterWithdraw = false
					gameState = "menu"
					loadMenu()

				elseif balance < 10 then
					gameState = "menu"
					loadMenu()

				else
					gameState = "betting"

					currentBet =
						math.min(
							currentBet,
							balance
						)

					if currentBet < MIN_BET then
						currentBet = MIN_BET
					end

					loadBettingScreen()
				end


            elseif a == recoveryTimer then
                recoveryTimer = nil
                updateRecoveryProgress()
            end
        end

        ::continue::
    end
end

local function authenticateUser(inputUser, inputPass)
    if isDatabaseServer then
        local authenticated, data =
            authenticateUserLocal(
                inputUser,
                inputPass
            )

        if not authenticated then
            return false,
                data or "Invalid credentials!"
        end

        if type(data) ~= "table"
            or type(data.user) ~= "table"
            or type(data.sessionToken) ~= "string"
        then
            return false,
                "Invalid authentication response."
        end

        data.user.sessionToken =
            data.sessionToken

        return true, nil, data.user
    end

    local success, data, errorMessage =
        databaseRequest(
            "authenticate",
            {
                username = inputUser,
                password = inputPass
            }
        )

    if not success then
        return false,
            errorMessage or "Invalid credentials!"
    end

    if type(data) ~= "table"
        or type(data.user) ~= "table"
        or type(data.sessionToken) ~= "string"
    then
        return false,
            "Invalid authentication response."
    end

    data.user.sessionToken =
        data.sessionToken

    return true, nil, data.user
end

local function getCurrentUserData(sessionToken)
    if isDatabaseServer then
        local currentUser =
            getSessionUser(
                sessionToken
            )

        if not currentUser then
            return false,
                nil,
                "Invalid or expired session."
        end

        return true,
            getPublicUser(
                currentUser
            )
    end

    local success, data, errorMessage =
        databaseRequest(
            "get_user",
            {
                sessionToken =
                    sessionToken
            }
        )

    if not success then
        return false, nil, errorMessage
    end

    if type(data) ~= "table"
        or type(data.username) ~= "string"
    then
        return false,
            nil,
            "Invalid user data returned by server."
    end

    return true, data
end

local function handleLogin()
    term.clear()
    term.setCursorPos(1, 1)

    if isDatabaseServer then
        print("NyatOS [SERVER] v3.0")
    else
        print("NyatOS v3.0")
    end

    print("")
    print("")
    print("")
    print("Please log in to continue.")
    print("")
    print("")

    if isDatabaseServer then
        print("[AUTHORIZED PERSONNEL ONLY!]")
    end

    print("")

    local inputUser

    repeat
        write("Username: ")
        inputUser = read()

        if inputUser == "" then
            print("Username cannot be empty. Please try again.")
            sleep(2)
        end
    until inputUser ~= ""

    local inputPass

    repeat
        write("Password: ")
        inputPass = read("*")

        if inputPass == "" then
            print("Password cannot be empty. Please try again.")
        end
    until inputPass ~= ""

    local isAuthenticated, message, user =
        authenticateUser(
            inputUser,
            inputPass
        )

    if not isAuthenticated then
        return false, message
    end

    if isDatabaseServer and not user.admin then
        return false, "Server access is restricted to administrators."
    end

    return true, nil, user
end

