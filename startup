local function renameUsername(oldUsername, newUsername)
    if isDatabaseServer then
        for _, u in ipairs(users) do
            if u.username == newUsername then
                return false, "Username already exists."
            end
        end

        local targetUser = nil

        for _, u in ipairs(users) do
            if u.username == oldUsername then
                targetUser = u
                break
            end
        end

        if not targetUser then
            return false, "User not found."
        end

        local saveSuccess, saveError =
            renameUserSavesLocal(
                oldUsername,
                newUsername
            )

        if not saveSuccess then
            return false, saveError or "Failed to rename user saves."
        end

        local oldUsernameValue = targetUser.username

        targetUser.username = newUsername

        if not saveUserDataLocal() then
            targetUser.username = oldUsernameValue

            renameUserSavesLocal(
                newUsername,
                oldUsername
            )

            return false, "Failed to save user data."
        end

        return true
    end

    local success, _, errorMessage =
        databaseRequest(
            "rename_user",
            {
                oldUsername = oldUsername,
                newUsername = newUsername
            }
        )

    if not success then
        return false, errorMessage or "Failed to rename user."
    end

    return true
end

