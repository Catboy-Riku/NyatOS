                                        0,
                                        totalLines
                                        - screenH
                                    )

                                userHasScrolled = true

                                if direction < 0 then
                                    -- Wheel UP = older output.
                                    scrollPosition =
                                        math.max(
                                            0,
                                            scrollPosition
                                            - 1
                                        )

                                elseif direction > 0 then
                                    -- Wheel DOWN = newer output.
                                    scrollPosition =
                                        math.min(
                                            maxScroll,
                                            scrollPosition
                                            + 1
                                        )

                                    if scrollPosition >= maxScroll then
                                        userHasScrolled =
                                            false
                                    end
                                end

                                redraw()
                            end
                        end
                    end

                    parallel.waitForAny(
                        runCommand,
                        handleMouseScroll
                    )

                    term.redirect(
                        previousTerm
                    )

                    if not commandOK then
                        local cursorX,
                            cursorY =
                            outputWindow.getCursorPos()

                        outputWindow.setCursorPos(
                            cursorX,
                            cursorY
                        )

                        outputWindow.write(
                            "ERROR: "
                            .. tostring(
                                commandError
                            )
                        )
                    end

                    local allLines =
                        getAllLines()

                    local totalLines =
                        #allLines

                    local maxScroll =
                        math.max(
                            0,
                            totalLines
                            - screenH
                        )

                    scrollPosition =
                        maxScroll

                    userHasScrolled =
                        false

                    redraw()

                    while true do
                        local event,
                            direction =
                            os.pullEvent()

                        if event == "mouse_scroll" then
                            local allLinesNow =
                                getAllLines()

                            local currentTotal =
                                #allLinesNow

                            local currentMaxScroll =
                                math.max(
                                    0,
                                    currentTotal
                                    - screenH
                                )

                            userHasScrolled =
                                true

                            if direction < 0 then
                                -- Wheel UP = older output.
                                scrollPosition =
                                    math.max(
                                        0,
                                        scrollPosition
                                        - 1
                                    )

                            elseif direction > 0 then
                                -- Wheel DOWN = newer output.
                                scrollPosition =
                                    math.min(
                                        currentMaxScroll,
                                        scrollPosition
                                        + 1
                                    )

                                if scrollPosition >= currentMaxScroll then
                                    userHasScrolled =
                                        false
                                end
                            end

                            redraw()

                        elseif event == "key" then
                            break
                        end
                    end

                    term.clear()
                    term.setCursorPos(
                        1,
                        1
                    )
                end

            until backToMenu

        elseif option == 18 then
            local backToMenu = false

            repeat
                term.clear()
                term.setCursorPos(1, 1)

                print("Enter the Minecraft command to execute")
                print("(or 'R' to return to the menu):")
                write("")

                local command = read()

                if command:match("^%s*$") then
                    term.clear()
                    term.setCursorPos(1, 1)

                    print("Error: You did not enter a command. Please try again.")
                    print("")
                    print("Press Enter to try again...")

                    read()

                elseif command:lower() == "r" then
                    backToMenu = true

                    term.clear()
                    term.setCursorPos(1, 1)

                    return true

                else
                    term.clear()
                    term.setCursorPos(1, 1)

                    print("Executing command: " .. command)
                    sleep(2)

                    local success, err = pcall(function()
                        commands.exec(command)
                    end)

                    if not success then
                        term.clear()
                        term.setCursorPos(1, 1)

                        print("MC commands only available on command computers.")
                        print("(Duh)")

                        sleep(4)
                    end
                end

            until backToMenu

        elseif option == 19 then
            term.clear()
            term.setCursorPos(1, 1)

            if isDatabaseServer then
                print("Updating NyatOS...")
                print("")

                fs.delete("startup")
                sleep(2)

                local success = shell.run(
                    "pastebin",
                    "get",
                    "XFgHwpHA",
                    "startup"
                )

                if not success then
                    print("")
                    print("NyatOS update failed.")
                    print("Unable to download the latest startup file.")
                    sleep(4)
                else
                    print("")
                    print("NyatOS update complete! Rebooting...")
                    sleep(3)

                    os.reboot()
                end

            else
                print("Updating NyatOS...")
                print("")
                print("Requesting latest version from NyatOS Server...")
                sleep(2)

                local success, startupData, errorMessage =
                    getServerStartup()

                if not success then
                    print("")
                    print("NyatOS update failed.")
                    print(
                        errorMessage
                        or "Could not contact NyatOS Server."
                    )

                    sleep(4)

                else
                    local file, err =
                        fs.open("startup", "w")

                    if not file then
                        print("")
                        print("NyatOS update failed.")
                        sleep(1)
                        print("Could not write the startup file.")
                        print(tostring(err))

                        sleep(4)

                    else
                        file.write(startupData)
                        file.close()

                        print("")
                        print("NyatOS updated from the server.")
                        sleep(1)
                        print("Rebooting...")

                        sleep(3)

                        os.reboot()
                    end
                end
            end

        elseif user.admin and option == "A" then
            return 2

        elseif user.admin and option == "U" then
            return 1

        else
            return true
        end

        return true
    end

    return true
end

local function handleLoginAttempts()
    local attempts = readLockoutState()

    if attempts >= maxAttempts then
        term.clear()
        term.setCursorPos(1, 1)

        print(
            "System Locked Due to Too Many Failed Attempts! Try again in 10 minutes."
        )

        sleep(lockoutDuration)

        writeLockoutState(0)
    end

    local isAuthenticated, message, user =
        handleLogin()

    if isAuthenticated then
        writeLockoutState(0)

        local loggedIn = true
        local currentPage = 1

        while loggedIn do
            local option, choice =
                showMenu(
                    user,
                    currentPage
                )

			if option == "A" then
				local wasAdmin = user.admin

				if not refreshCurrentUser(user) then
					loggedIn = false

				elseif not user.admin then
					if wasAdmin then
						term.clear()
						term.setCursorPos(1, 1)

						print("Your admin privileges have been revoked.")
						print("")
						print("You have been logged out.")

						sleep(4)

						loggedIn = false
					end
				else
					currentPage = 2
				end

            elseif option == "U" then
                currentPage = 1

            elseif currentPage == 2 then
                if not refreshCurrentUser(user) then
                    loggedIn = false

                elseif not user.admin then
                    term.clear()
                    term.setCursorPos(1, 1)

                    print("Your admin privileges have been revoked.")
                    print("")
                    print("You have been logged out.")

                    sleep(4)

                    loggedIn = false
                else
                    loggedIn =
                        handleMenuOption(
                            choice,
                            user
                        )
                end

            else
                loggedIn =
                    handleMenuOption(
                        choice,
                        user
                    )
            end
        end

    else
        term.clear()
        term.setCursorPos(1, 1)

        print(message)
        sleep(3)

        if message == "Invalid credentials!" then
            attempts = attempts + 1
            writeLockoutState(attempts)
        end
    end

    return attempts
end

local function runServerOS()
    while true do
        handleLoginAttempts()
    end
end

local function main()
    if isDatabaseServer then
        users = loadUserDataLocal()

        parallel.waitForAny(
            databaseServer,
            runServerOS
        )
    else
        while true do
            handleLoginAttempts()
        end
    end
end

-- Protected call to prevent termination after initial setup
while true do
    local ok, err = pcall(main)

    if not ok then
        term.redirect(term.native())

        if err == "Terminated" then
            term.clear()
            term.setCursorPos(1, 1)

            local function typeText(text, delay)
                local position = 1

                while position <= #text do
                    local success = pcall(function()
                        write(text:sub(position, position))
                        sleep(delay)
                    end)

                    if success then
                        position = position + 1
                    end
                end
            end

            typeText("I'm sorry, Dave.", 0.05)
            pcall(sleep, 1)
            print("")
            typeText("I'm afraid I can't do that.", 0.05)

            while true do
                local success = pcall(sleep, 3)

                if success then
                    break
                end
            end

        else
            printError("Unexpected error: " .. tostring(err))
            pcall(sleep, 3)
        end
    end
end
