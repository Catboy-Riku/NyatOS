local function renameUserSavesLocal(oldUsername, newUsername)
    if oldUsername == newUsername then
        return true
    end

    local allSaves = loadUserSavesLocal()

    if allSaves[newUsername] ~= nil then
        return false, "A save already exists for the new username."
    end

    if allSaves[oldUsername] ~= nil then
        allSaves[newUsername] = allSaves[oldUsername]
        allSaves[oldUsername] = nil
    end

    return saveUserSavesLocal(allSaves)
end

local function databaseRequest(action, data)
    local modem, modemError = getModem()

    if not modem then
        return false, nil, modemError
    end

    local cryptoKey =
        getDatabaseCryptoKey()

    if type(cryptoKey) ~= "string"
        or cryptoKey == ""
    then
        if isDatabaseServer then
            cryptoKey =
                crypto.generateKey()

            local saveOK =
                setClientCryptoKeyLocal(
                    os.getComputerID(),
                    cryptoKey
                )

            if not saveOK then
                return false,
                    nil,
                    "Could not save server database encryption key."
            end

        else
            local provisionOK,
                provisionError =
                requestCryptoKey()

            if not provisionOK then
                return false,
                    nil,
                    "Could not provision database encryption key: "
                    .. tostring(provisionError)
            end

            cryptoKey =
                getDatabaseCryptoKey()

            if type(cryptoKey) ~= "string"
                or cryptoKey == ""
            then
                return false,
                    nil,
                    "Database encryption key is still missing."
            end
        end
    end

    if type(cryptoKey) ~= "string"
        or cryptoKey == ""
    then
        return false,
            nil,
            "Database encryption key is missing."
    end

    modem.open(REPLY_CHANNEL)

    local requestID =
        tostring(os.getComputerID())
        .. "-"
        .. tostring(os.epoch("utc"))
        .. "-"
        .. tostring(math.random(1, 1000000))

    local clientID =
        os.getComputerID()

    local requestTimestamp =
        os.epoch("utc")

    local associatedData =
        "nyatos-db-request|"
        .. tostring(clientID)
        .. "|"
        .. requestID
        .. "|"
        .. tostring(requestTimestamp)

    local requestPayload = {
        action = action,
        data = data
    }

    local encryptOK,
        encryptedPacket,
        encryptError =
        crypto.encrypt(
            cryptoKey,
            textutils.serialize(
                requestPayload
            ),
            associatedData,
            cryptoNonceFile,
            "database-request"
        )

    if not encryptOK then
        return false,
            nil,
            "Failed to encrypt database request: "
            .. tostring(encryptError)
    end

    local request = {
        requestID = requestID,
        clientID = clientID,
        timestamp = requestTimestamp,
        encrypted = true,
        packet = encryptedPacket
    }

    modem.transmit(
        DATABASE_CHANNEL,
        REPLY_CHANNEL,
        textutils.serialize(request)
    )

    local timer =
        os.startTimer(5)

    while true do
        local event,
            p1,
            p2,
            p3,
            p4 =
            os.pullEvent()

        if event == "modem_message" then
            local channel = p2
            local message = p4

            if channel == REPLY_CHANNEL
                and type(message) == "string"
            then
                local response =
                    textutils.unserialize(
                        message
                    )

                if type(response) == "table"
                    and response.requestID == requestID
                    and response.clientID == clientID
                    and response.encrypted == true
                    and type(response.packet) == "table"
                then
                    local responseAssociatedData =
                        "nyatos-db-response|"
                        .. tostring(clientID)
                        .. "|"
                        .. requestID

                    local decryptOK,
                        decryptedResponse,
                        decryptError =
                        crypto.decrypt(
                            cryptoKey,
                            response.packet,
                            responseAssociatedData
                        )

                    if decryptOK then
                        local responseData =
                            textutils.unserialize(
                                decryptedResponse
                            )

                        if type(responseData) == "table" then
                            os.cancelTimer(timer)

                            if responseData.ok then
                                return true,
                                    responseData.data
                            end

                            return false,
                                nil,
                                responseData.error
                                or "Unknown database error."
                        end
                    end
                end
            end

        elseif event == "timer"
            and p1 == timer
        then
            return false,
                nil,
                "Database server did not respond. Contact system admin."
        end
    end
end

