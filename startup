local function getPublicUser(user)
    if type(user) ~= "table" then
        return nil
    end

    return {
        username = user.username,
        admin = user.admin == true,
        rsAccess = user.rsAccess == true
    }
end

local function createSession(username)
    local token

    repeat
        token =
            tostring(os.getComputerID())
            .. "-"
            .. tostring(os.epoch("utc"))
            .. "-"
            .. tostring(math.random(1, 1000000000))
    until sessions[token] == nil

    sessions[token] = {
        username = username,
        created = os.epoch("utc")
    }

    return token
end


local function getSessionUser(sessionToken)
    if type(sessionToken) ~= "string"
        or sessionToken == ""
    then
        return nil
    end

    local session =
        sessions[sessionToken]

    if type(session) ~= "table"
        or type(session.username) ~= "string"
    then
        return nil
    end

    for _, user in ipairs(users) do
        if user.username == session.username then
            return user
        end
    end

    sessions[sessionToken] = nil

    return nil
end


local function destroySession(sessionToken)
    if type(sessionToken) == "string" then
        sessions[sessionToken] = nil
    end
end

local function authenticateUserLocal(inputUser, inputPass)
    for _, user in ipairs(users) do
        if user.username == inputUser
            and user.password == inputPass
        then
            local sessionToken =
                createSession(
                    user.username
                )

            return true, {
                user = getPublicUser(user),
                sessionToken = sessionToken
            }
        end
    end

    return false, "Invalid credentials!"
end

local function authenticateAdminLocal(sessionToken)
    local user =
        getSessionUser(
            sessionToken
        )

    if not user then
        return false, nil, "Invalid or expired session."
    end

    if not user.admin then
        return false, nil, "Administrator privileges required."
    end

    return true, user
end

