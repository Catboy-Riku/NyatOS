local seenDatabaseRequests = {}

local function cleanupDatabaseRequests()
    local now = os.epoch("utc")

    for clientID, requests in pairs(
        seenDatabaseRequests
    ) do
        for requestID, timestamp in pairs(requests) do
            if now - timestamp > DATABASE_REPLAY_WINDOW * 1000 then
                requests[requestID] = nil
            end
        end

        if next(requests) == nil then
            seenDatabaseRequests[clientID] = nil
        end
    end
end

