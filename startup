            (
                os.epoch("utc")
                - recoveryStartTime
            ) / 1000

        local progress =
            math.min(
                elapsed / RECOVERY_DURATION,
                1
            )

        local BAR_WIDTH =
            math.max(
                10,
                screenW - 8
            )

        local filledWidth =
            math.floor(
