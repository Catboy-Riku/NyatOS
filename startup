	local function withdrawFunds()
		monitor.setBackgroundColor(colors.lime)
		monitor.setTextColor(colors.white)
		monitor.clear()

		if balance < 100 then
			local message = "Get your money up!"

			monitor.setCursorPos(
				screenCenterX + 1
					- math.floor(#message / 2),
				screenCenterY - 1
			)

			monitor.write(message)

			local balanceText =
				"Balance: " .. balance

			monitor.setCursorPos(
				screenCenterX + 1
					- math.floor(#balanceText / 2),
				screenCenterY + 1
			)

			monitor.write(balanceText)
			
			returnToMenuAfterWithdraw = true

			resetTimer =
				os.startTimer(2)

			return
		end

		monitor.setBackgroundColor(colors.lime)
		monitor.setTextColor(colors.white)
		monitor.clear()

		local dispensing =
			"Dispensing..."

		monitor.setCursorPos(
			screenCenterX + 1
				- math.floor(#dispensing / 2),
			screenCenterY
		)

		monitor.write(dispensing)

		sleep(1.5)

		local copperCommandOK,
			copperSuccess =
			pcall(
				function()
					return commands.exec(
						"give @p companions:copper_coin"
					)
				end
			)

		local success =
			copperCommandOK
			and copperSuccess == true

		if not success then
			local goldCommandOK,
				goldSuccess =
				pcall(
					function()
						return commands.exec(
							"give @p minecraft:gold_ingot"
						)
					end
				)

			success =
				goldCommandOK
				and goldSuccess == true
		end

		if not success then
			local message1 =
				"Withdrawals require"

			local message2 =
				"a command computer."

			monitor.setCursorPos(
				screenCenterX + 1
					- math.floor(#message1 / 2),
				screenCenterY - 2
			)
			monitor.write(message1)

			monitor.setCursorPos(
				screenCenterX + 1
					- math.floor(#message2 / 2),
				screenCenterY
			)
			monitor.write(message2)

			monitor.setCursorPos(
				screenCenterX + 1
					- math.floor(#"(Purple/Copper PCs)" / 2),
				screenCenterY + 2
			)
			monitor.write("(Purple/Copper PCs)")

			returnToMenuAfterWithdraw = true

			resetTimer =
				os.startTimer(3)

			return
		end

		monitor.setBackgroundColor(colors.lime)
		monitor.setTextColor(colors.white)
		monitor.clear()

		balance =
			balance - 100

		saveBalance()

		monitor.setTextColor(colors.yellow)

		local successText =
			"Withdrawal successful!"

		monitor.setCursorPos(
			screenCenterX + 1
				- math.floor(#successText / 2),
			screenCenterY - 2
		)

		monitor.write(successText)

		monitor.setTextColor(colors.white)

		local coinText =
			"Copper Coin dispensed."

		monitor.setCursorPos(
			screenCenterX + 1
				- math.floor(#coinText / 2),
			screenCenterY
		)

		monitor.write(coinText)

		local newBalance =
			"Balance: " .. balance

		monitor.setCursorPos(
			screenCenterX + 1
				- math.floor(#newBalance / 2),
			screenCenterY + 2
		)

		monitor.write(newBalance)
		
		returnToMenuAfterWithdraw = true

		resetTimer =
			os.startTimer(3)
	end

