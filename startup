        for copy = 1, 4 do
            for _, rank in ipairs(ranks) do
                table.insert(newDeck, rank)
            end
        end

        return newDeck
    end

    local function shuffleDeck(deckToShuffle)
        for i = #deckToShuffle, 2, -1 do
            local j = math.random(i)

            deckToShuffle[i], deckToShuffle[j] =
                deckToShuffle[j], deckToShuffle[i]
        end
    end

    local function resetDeck()
        deck = createDeck()
        shuffleDeck(deck)
    end

    local function drawFromDeck()
        if #deck == 0 then
            error("The deck ran out of cards during the round.")
        end

        return table.remove(deck)
    end

    local function giveCard(hand)
        table.insert(hand, drawFromDeck())
    end

    local function calculateHandValue(hand)
        local value = 0
        local aceCount = 0

        for _, card in ipairs(hand) do
            if card == "K"
                or card == "Q"
                or card == "J"
            then
                value = value + 10

            elseif card == "A" then
                value = value + 11
                aceCount = aceCount + 1

            else
                value = value + tonumber(card)
            end
        end

        while value > 21 and aceCount > 0 do
            value = value - 10
            aceCount = aceCount - 1
        end

        return value
    end

    local function getHandInfo(hand)
        local value = 0
        local aceCount = 0
        local acesAsEleven = 0

        for _, card in ipairs(hand) do
            if card == "K"
                or card == "Q"
                or card == "J"
            then
                value = value + 10

            elseif card == "A" then
                value = value + 11
                aceCount = aceCount + 1
                acesAsEleven = acesAsEleven + 1

            else
                value = value + tonumber(card)
            end
        end

        while value > 21 and aceCount > 0 do
            value = value - 10
            aceCount = aceCount - 1
            acesAsEleven = acesAsEleven - 1
        end

        return {
            value = value,
            soft = acesAsEleven > 0
        }
    end

    local function isBust(hand)
        return calculateHandValue(hand) > 21
    end

    local function isBlackjack(hand)
        return #hand == 2
            and calculateHandValue(hand) == 21
    end

    local function getAllDealerCards()
        local allCards = {}

        for _, card in ipairs(dealerHand.visible) do
            table.insert(allCards, card)
        end

        for _, card in ipairs(dealerHand.hidden) do
            table.insert(allCards, card)
        end

        return allCards
    end

    local function revealDealerHand()
        for _, card in ipairs(dealerHand.hidden) do
            table.insert(
                dealerHand.visible,
                card
            )
        end

        dealerHand.hidden = {}
    end

    local function playDealerTurn()
        revealDealerHand()

        while true do
            local dealerInfo =
                getHandInfo(
                    dealerHand.visible
                )

            if dealerInfo.value > 21 then
                break
            end

            if dealerInfo.value < 17 then
                giveCard(dealerHand.visible)

            elseif dealerInfo.value == 17
                and dealerInfo.soft
                and not STAND_ON_SOFT_17
            then
                giveCard(dealerHand.visible)

            else
                break
            end
        end
    end

    local function determineWinner()
        local playerValue =
            calculateHandValue(playerHand)

        local dealerValue =
            calculateHandValue(
                dealerHand.visible
            )

        local playerBlackjack =
            isBlackjack(playerHand)

        local dealerBlackjack =
            isBlackjack(
                dealerHand.visible
            )

        if playerBlackjack
            and dealerBlackjack
        then
            return "push"

        elseif playerBlackjack then
            return "blackjack"

        elseif dealerBlackjack then
            return "dealer"

        elseif playerValue > 21 then
            return "dealer"

        elseif dealerValue > 21 then
            return "player"

        elseif playerValue > dealerValue then
            return "player"

        elseif dealerValue > playerValue then
            return "dealer"

        else
            return "push"
        end
    end

    local function payoutRound(result)
        if result == "blackjack" then
            local winnings =
                (
                    currentBet
                    * BLACKJACK_PAYOUT_NUMERATOR
                )
                / BLACKJACK_PAYOUT_DENOMINATOR

            balance =
                balance
                + currentBet
                + winnings

        elseif result == "player" then
            balance =
                balance
                + (currentBet * 2)

        elseif result == "push" then
            balance =
                balance
                + currentBet
        end

        saveBalance()
    end

